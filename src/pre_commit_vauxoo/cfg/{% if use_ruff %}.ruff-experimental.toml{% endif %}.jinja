# Experimental ruff checks (they won't affect the CI status, same as the pylint EXPERIMENTAL hook)
# It replaces the pylint-odoo and bandit experimental checks already implemented in ruff, keeping
# the same level they had before the ruff migration (see .config/.pylintrc-experimental and
# .config/.bandit-experimental.yml without ruff)
line-length = 119
# Required to select the checks by name instead of by code (selecting rules by name requires
# preview mode)
preview = true
target-version = "{{ py_target_version }}"  # Mapped from the odoo version (VERSION or --odoo-version)

[lint]
# Only the experimental checks are selected, the "all" default would report the mandatory
# and optional ones twice
# manifest-superfluous-key was experimental too but it is autofixable, so it keeps running
# from .ruff-autofix.toml (removing the superfluous keys is part of the autofixes enabled by
# the compatibility version 30, see the --compatibility-version option)
# no-search-all was experimental too and is now mandatory from .ruff.toml: it no longer reports
# every model, only the ones that grow, so it is actionable enough to block a merge request
select = [
    # bandit replacement (same checks previously running from .config/.bandit-experimental.yml,
    # which ran every bandit test except the ones listed in its "skips" option, mirrored in the
    # "ignore" below). ruff numbers its flake8-bandit rules after bandit's own test ids, so
    # B101 is S101, B602 is S602 and so on
    "S",
    # B613 (trojansource) is the only remaining bandit test without an S rule, ruff reports the
    # same bidirectional control characters from pylint instead
    "bidirectional-unicode",
]

ignore = [
{% if ruff_disable_checks %}
    # Disabled from RUFF_DISABLE_CHECKS option
{% for check in ruff_disable_checks %}
    "{{ check }}",
{% endfor %}
{% endif %}
    # Same skips as the old .config/.bandit-experimental.yml
    # hardcoded-sql-expression (B608) is considered from the ruff-odoo sql-injection check
    "hardcoded-sql-expression",
    # defusedxml checks (B313-B319 and B405-B409): Odoo's team via inbox twitter is not convinced
    # to repair them and the entire Odoo is raising these checks
    "suspicious-xmlc-element-tree-usage",
    "suspicious-xml-element-tree-usage",
    "suspicious-xml-expat-reader-usage",
    "suspicious-xml-expat-builder-usage",
    "suspicious-xml-sax-usage",
    "suspicious-xml-mini-dom-usage",
    "suspicious-xml-pull-dom-usage",
    "suspicious-xml-etree-import",
    "suspicious-xml-sax-import",
    "suspicious-xml-expat-import",
    "suspicious-xml-minidom-import",
    "suspicious-xml-pulldom-import",
    # Reported from another level, so they are not repeated here (B102, B307, B704, B110, B101
    # and B311)
    "exec-builtin",  # mandatory from .ruff.toml
    "suspicious-eval-usage",  # mandatory from .ruff.toml
    "try-except-pass",  # optional from .ruff-optional.toml, where it also replaces the
                        # deprecated ruff-odoo except-pass, which reported the same handler
    "unsafe-markup-use",  # optional from .ruff-optional.toml
    # Moved to the optional configuration: both are worth a look on every merge request and not
    # only when the developer opts into this hook, an assert being dropped by "python -O" and a
    # Mersenne Twister random being unfit for anything secret
    "assert",  # optional from .ruff-optional.toml
    "suspicious-non-cryptographic-random-usage",  # optional from .ruff-optional.toml
]

[lint.per-file-ignores]
"**/migrations/**" = [
    "S",  # Migration scripts run once, from a controlled environment, so they are not an
          # attack surface (same reasoning as the "tests/" ignore below)
]
"**/tests/**" = [
    "S",  # Same as the "exclude_dirs: tests" of the old .bandit-experimental.yml
]

[lint.odoo]
# Version-scoped Odoo checks are gated by ruff-odoo based on this odoo-version setting
{%- if odoo_version %}
odoo-version = "{{ odoo_version }}"
{%- endif %}
