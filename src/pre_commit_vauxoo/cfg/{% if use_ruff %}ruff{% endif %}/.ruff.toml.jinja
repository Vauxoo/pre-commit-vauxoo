# Mandatory ruff checks
# It runs ruff-odoo (https://github.com/Vauxoo/ruff-odoo), the Vauxoo fork of ruff
# with the Odoo-specific rules ported from pylint-odoo and odoo-pre-commit-hooks
# There is no optional ruff configuration anymore: the checks that used to run from
# .ruff-optional.toml are selected here, so a single ruff-odoo hook reports all of them and
# all of them affect the build status. Only the experimental ones keep a level of their own
# (see .ruff-experimental.toml)
# It replaces the flake8, flake8-bugbear, pylint and bandit checks already implemented in ruff:
#  - flake8 only keeps the continuation-line rules (E12x/E13x/E704) not implemented in ruff and
#    the bugbear checks without a ruff implementation (see .flake8)
#  - pylint only keeps the checks without a ruff equivalent (see .pylintrc "migrated to ruff" section)
line-length = 119
# Required by the pycodestyle rules migrated from flake8, by compare-to-empty-string,
# return-in-generator, class-as-data-structure and loop-iterator-mutation, and to select the
# checks by name instead of by code (selecting rules by name requires preview mode)
preview = true
target-version = "{{ py_target_version }}"  # Mapped from the odoo version (VERSION or --odoo-version)
{%- if additional_builtins %}
# Names injected at runtime, from LINT_ADDITIONAL_BUILTINS
builtins = {{ additional_builtins | list | tojson }}
{%- endif %}

[lint]
select = [
    # flake8 replacement (same checks previously running from .config/.flake8)
    "E",  # pycodestyle errors (E12x continuation-line rules still running from flake8)
    "W",  # pycodestyle warnings
    "F",  # pyflakes (it also replaces the pylint checks undefined-variable, unused-import, unused-variable,
          # duplicate-key, assert-on-tuple, wildcard-import, misplaced-future, literal-comparison,
          # the %-format and str.format checks (truncated-format-string, mixed-format-string,
          # format-needs-mapping, missing-format-string-key, too-many/few-format-args, bad-format-string,
          # unused-format-string-key/argument, missing-format-argument-key, format-combined-specification),
          # duplicate-argument-name (reported as an always-on ruff syntax error),
          # notimplemented-raised, f-string-without-interpolation, not-in-loop,
          # return-outside-function, yield-outside-function, too-many-star-expressions and undefined-all-variable)
    # pylint mandatory checks with a ruff replacement (disabled now from .config/.pylintrc)
    "assert-on-string-literal",
    "await-outside-async",
    "bad-open-mode",
    "bad-staticmethod-argument",
    "bad-str-strip-call",
    "bad-string-format-character",  # bad-format-character
    "bad-string-format-type",
    "bidirectional-unicode",
    "binary-op-exception",
    "boolean-chained-comparison",  # chained-comparison
    "builtin-argument-shadowing",  # redefined-builtin (arguments)
    "builtin-import-shadowing",  # redefined-builtin (imports)
    "builtin-variable-shadowing",  # redefined-builtin (variables)
    "cached-instance-method",  # method-cache-max-size-none
    "comparison-of-constant",  # comparison-of-constants
    "comparison-with-itself",
    "continue-in-finally",
    "debugger",  # forgotten-debug-statement
    "dict-iter-missing-items",
    "double-negation",  # unnecessary-negation
    "duplicate-bases",
    "duplicate-isinstance-call",  # consider-merging-isinstance
    "duplicate-try-block-exception",  # duplicate-except
    "duplicate-value",
    "empty-docstring",
    "exec-builtin",  # exec-used
    "expr-and-false",  # condition-evals-to-constant (x and False)
    "expr-and-not-expr",  # condition-evals-to-constant (x and not x)
    "expr-or-not-expr",  # condition-evals-to-constant (x or not x)
    "expr-or-true",  # condition-evals-to-constant (x or True)
    "global-at-module-level",
    "global-statement",
    "global-variable-not-assigned",
    "if-else-block-instead-of-dict-get",  # consider-using-get (autofixed from .ruff-autofix.toml,
                                          # selected here to keep the mandatory level it had in pylint)
    "if-expr-with-false-true",  # simplifiable-if-expression (False if x else True)
    "if-expr-with-true-false",  # simplifiable-if-expression (True if x else False)
    "if-stmt-min-max",  # consider-using-min-builtin and consider-using-max-builtin
    "import-outside-top-level",  # import-outside-toplevel
    "in-dict-keys",  # consider-iterating-dictionary
    "invalid-all-format",
    "invalid-all-object",
    "invalid-bool-return-type",  # invalid-bool-returned
    "invalid-bytes-return-type",  # invalid-bytes-returned
    "invalid-character-backspace",
    "invalid-character-esc",
    "invalid-character-nul",
    "invalid-character-sub",
    "invalid-character-zero-width-space",
    "invalid-envvar-value",
    "invalid-first-argument-name-for-class-method",  # bad-classmethod-argument
    "invalid-first-argument-name-for-method",  # no-self-argument
    "invalid-hash-return-type",  # invalid-hash-returned
    "invalid-index-return-type",  # invalid-index-returned
    "invalid-length-return-type",  # invalid-length-returned
    "invalid-str-return-type",  # invalid-str-returned
    "iteration-over-set",  # use-sequence-for-iteration
    "jump-statement-in-finally",  # lost-exception
    "len-test",  # use-implicit-booleaness-not-len
    "load-before-global-declaration",  # used-prior-global-declaration
    "logging-f-string",  # logging-fstring-interpolation
    "logging-percent-format",  # logging-not-lazy (%)
    "logging-string-concat",  # logging-not-lazy (+ concatenation)
    "logging-string-format",  # logging-format-interpolation
    "logging-too-few-args",
    "logging-too-many-args",
    "manual-from-import",  # consider-using-from-import
    "misplaced-bare-raise",
    "missing-maxsplit-arg",  # use-maxsplit-arg
    "modified-iterating-set",
    "mutable-argument-default",  # dangerous-default-value
    "named-expr-without-context",
    "nan-comparison",
    "needless-bool",  # simplifiable-if-statement
    "nested-min-max",
    "no-classmethod-decorator",
    "no-staticmethod-decorator",
    "non-ascii-import-name",  # non-ascii-module-import
    "non-ascii-name",
    "non-slot-assignment",  # assigning-non-slot
    "nonlocal-and-global",
    "nonlocal-without-binding",
    "potential-index-error",
    "property-with-parameters",
    "redeclared-assigned-name",
    "redefined-argument-from-local",
    "redefined-slots-in-subclass",
    "repeated-equality-comparison",  # consider-using-in
    "repeated-keyword-argument",  # repeated-keyword
    "return-in-init",
    "self-assigning-variable",
    "shallow-copy-environ",
    "single-string-slots",  # single-string-used-for-slots
    "singledispatch-method",
    "singledispatchmethod-function",
    "stop-iteration-return",
    "subprocess-popen-preexec-fn",
    "subprocess-run-without-check",  # subprocess-run-check
    "super-call-with-parameters",  # super-with-arguments
    "super-without-brackets",
    "superfluous-else-break",  # no-else-break
    "superfluous-else-continue",  # no-else-continue
    "superfluous-else-raise",  # no-else-raise
    "superfluous-else-return",  # no-else-return
    "suspicious-eval-usage",  # eval-used
    "swap-with-temporary-variable",  # consider-swap-variables
    "sys-exit-alias",  # consider-using-sys-exit
    "too-many-arguments",
    "too-many-locals",
    "too-many-nested-blocks",
    "too-many-public-methods",
    "too-many-return-statements",
    "trailing-comma-on-bare-tuple",  # trailing-comma-tuple
    "type-bivariance",  # typevar-double-variance
    "type-name-incorrect-variance",  # typevar-name-incorrect-variance
    "type-param-name-mismatch",  # typevar-name-mismatch
    "unary-prefix-increment-decrement",  # nonexistent-operator
    "unexpected-special-method-signature",
    "unnecessary-comprehension",
    "unnecessary-comprehension-in-call",  # use-a-generator (with preview it also covers
                                          # consider-using-generator, which was optional in pylint,
                                          # but a single ruff rule reports both so it keeps the
                                          # mandatory level of use-a-generator)
    "unnecessary-dict-index-lookup",
    "unnecessary-direct-lambda-call",
    "unnecessary-dunder-call",
    "unnecessary-generator-dict",  # consider-using-dict-comprehension for dict(generator)
    "unnecessary-generator-set",  # consider-using-set-comprehension for set(generator)
    "unnecessary-lambda",
    "unnecessary-list-comprehension-dict",  # consider-using-dict-comprehension for dict([...])
    "unnecessary-list-comprehension-set",  # consider-using-set-comprehension for set([...])
    "unnecessary-list-index-lookup",
    "unnecessary-placeholder",  # unnecessary-pass
    "useless-else-on-loop",
    "useless-exception-statement",  # pointless-exception-statement
    "useless-expression",  # expression-not-assigned and pointless-statement, both mandatory in
                           # pylint (a single ruff rule reports the two of them)
    "useless-import-alias",
    "useless-object-inheritance",
    "useless-return",
    "useless-with-lock",
    "yield-from-in-async-function",  # yield-inside-async-function
    "yield-in-for-loop",  # use-yield-from
    "yield-in-init",  # init-is-generator
    # Odoo checks from ruff-odoo (ported from pylint-odoo and odoo-pre-commit-hooks)
    # The ones that were mandatory in pylint-odoo are selected here, the ones that were optional
    # are selected in the "checks promoted from the optional configuration" block below:
    #  - no-search-all was experimental in pylint-odoo and is promoted to mandatory here: since
    #    ruff-odoo 0.16.3.31 it only reports an unlimited search on the models that actually grow
    #    (see the no-search-all-models option), which is a real performance bug worth blocking a
    #    merge request rather than a warning nobody reads
    #  - The autofixable ones (manifest-deprecated-key, unused-logger and header-comments) run
    #    from the autofix configuration instead (see .ruff-autofix.toml).
    #    prefer-env-translation and prefer-env-attribute (deprecated-self-cr) are autofixable too
    #    but they were mandatory, so they are also selected here to keep reporting them when the
    #    autofix hook is not executed
    #  - manifest-required-author, license-allowed and manifest-deprecated-key are selected in
    #    the promoted block below, and the [lint.odoo] options keep the values the [ODOOLINT]
    #    section of .pylintrc-optional configured for them
    #  - Version-dependent gating is handled by ruff-odoo's internal logic when --odoo-version
    #    is passed to ruff-odoo; all version-scoped checks are always enabled here and ruff-odoo
    #    filters them
    "category-allowed",  # Inert until the category-allowed option is set (see [lint.odoo])
    "consider-merging-classes-inherited",
    "deprecated-inselect-operator",
    "deprecated-name-get",
    "development-status-allowed",
    "inheritable-method-lambda",
    "inheritable-method-string",
    "invalid-commit",
    "invalid-email",
    "manifest-behind-migrations",
    "manifest-external-assets",
    "manifest-required-key",
    "manifest-summary-multiline",
    "missing-odoo-file",  # Inert until the odoo-required-files option is set (see [lint.odoo])
    "no-raise-unlink",
    "no-search-all",
    "no-wizard-in-models",
    "no-write-in-compute",
    "prefer-env-attribute",  # deprecated-self-cr, autofixed from .ruff-autofix.toml, reported
                             # here as mandatory the same way prefer-env-translation is
    "prefer-env-translation",  # Autofixed from .ruff-autofix.toml, reported here as mandatory
    "prohibited-method-override",
    "super-method-mismatch",
    "test-folder-imported",
    "translation-injection",
    # ------------------------------------------------------------------------------------
    # Checks promoted from the optional configuration (they used to run from
    # .ruff-optional.toml, which no longer exists: every one of them affects the build status
    # now, so a single ruff-odoo hook reports the whole set)
    # ------------------------------------------------------------------------------------
    # flake8-bugbear replacement (they used to run from .config/.flake8-optional)
    #  - unary-prefix-increment-decrement, mutable-argument-default, jump-statement-in-finally,
    #    cached-instance-method, duplicate-try-block-exception and duplicate-value are already
    #    selected above
    #  - The bugbear B001 is covered by bare-except and B902 by invalid-first-argument-name-for-method
    #    and invalid-first-argument-name-for-class-method (all selected above)
    #  - function-uses-loop-variable, abstract-base-class-without-abstract-method,
    #    raise-without-from-inside-except, zip-without-explicit-strict and the bugbear B036 and B907
    #    keep being disabled (see .flake8 comments)
    #  - The bugbear B040, B042, B906, B908, B910 and B950 are not implemented in ruff so they
    #    keep running from flake8
    "assert-false",
    "assert-raises-exception",
    "assignment-to-os-environ",
    "batched-without-explicit-strict",
    "class-as-data-structure",
    "del-attr-with-constant",
    "duplicate-handler-exception",
    "empty-method-without-abstract-decorator",
    "except-with-empty-tuple",
    "except-with-non-exception-classes",
    "f-string-docstring",
    "function-call-in-default-argument",
    "get-attr-with-constant",
    "loop-iterator-mutation",
    "loop-variable-overrides-iterator",
    "mutable-contextvar-default",
    "no-explicit-stacklevel",
    "raise-literal",
    "re-sub-positional-args",
    "redundant-tuple-in-exception-handler",
    "return-in-generator",
    "reuse-of-groupby-generator",
    "set-attr-with-constant",
    "star-arg-unpacking-after-keyword-arg",
    "static-key-dict-comprehension",
    "strip-with-multi-characters",
    "unintentional-type-annotation",
    "unreliable-callable-check",
    "unused-loop-control-variable",
    "useless-comparison",
    "useless-contextlib-suppress",
    # bandit replacement
    #  - unsafe-markup-use was the only check enabled in the old .config/.bandit-optional.yml
    #  - assert and suspicious-non-cryptographic-random-usage come from the experimental
    #    configuration: an assert is dropped by "python -O" and a random built on the Mersenne
    #    Twister is fine for anything that is not a secret, so both are worth a look but neither
    #    should fail the build only when the developer opts into the experimental hook. Both are
    #    ignored under tests/ like the rest of the family (see [lint.per-file-ignores]), which
    #    reproduces the "exclude_dirs: tests" of the old bandit configuration
    "assert",  # B101 assert_used
    "suspicious-non-cryptographic-random-usage",  # B311 random
    "unsafe-markup-use",  # B704 markupsafe_markup_xss
    # Checks enabled in the optional flake8 but ignored in the mandatory one
    #  - ambiguous-variable-name is disabled at every level now (see the ignore below)
    "redefined-while-unused",
    "tab-after-comma",  # tab after ','
    # line-too-long with the same 10% tolerance bugbear B950 applies (see [lint.pycodestyle]),
    # which is what used to report it from flake8-optional
    "line-too-long",
    # pylint optional checks with a ruff replacement (removed now from .config/.pylintrc-optional)
    #  - request-without-timeout is not selected since the ruff-odoo external-request-timeout
    #    covers it (requests + more libraries)
    "try-except-pass",  # It reports the same handler the ruff-odoo except-pass did (an "except"
                        # whose whole body is a "pass"), so except-pass is deprecated in favor of
                        # it and this configuration keeps the one that stays. It also runs from the
                        # experimental bandit replacement as S110, ignored there for this reason
    "compare-to-empty-string",  # use-implicit-booleaness-not-comparison-to-string
    "complex-structure",  # too-complex (mccabe)
    "multi-line-summary-first-line",  # docstring-first-line-empty
    "print",  # print-used
    "single-line-implicit-string-concatenation",  # implicit-str-concat
    "triple-single-quotes",  # bad-docstring-quotes
    "unicode-kind-prefix",  # redundant-u-string-prefix
    "unnecessary-collection-call",  # use-dict-literal and use-list-literal (a single check for
                                    # dict()/list()/tuple())
    # Odoo checks from ruff-odoo that were optional in pylint-odoo
    #  - The autofixable ones (attribute-string-redundant, manifest-data-duplicated,
    #    manifest-deprecated-key, translation-not-lazy and use-vim-comment) are autofixed from
    #    .ruff-autofix.toml, they are also selected here to keep reporting them when the autofix
    #    hook is not executed
    #  - license-allowed, manifest-required-author and manifest-deprecated-key use the [lint.odoo]
    #    options below with the same values the [ODOOLINT] section of .pylintrc-optional used
    "attribute-deprecated",
    "attribute-string-redundant",
    "bad-builtin-groupby",
    "context-overridden",
    "deprecated-odoo-model-method",
    #  - except-pass is deprecated in ruff-odoo, the flake8-bandit try-except-pass selected above
    #    reports the very same handler
    "external-request-timeout",  # request-without-timeout is a subset of it, don't enable both
    "license-allowed",  # It uses the license-allowed option (see [lint.odoo])
    "manifest-author-string",
    "manifest-data-duplicated",
    "manifest-deprecated-key",  # It uses the manifest-deprecated-keys default (see [lint.odoo])
    "manifest-maintainers-list",
    "manifest-required-author",  # It uses the manifest-required-authors option (see [lint.odoo])
    "manifest-version-format",  # It uses the odoo-version option (see [lint.odoo])
    "method-compute",
    "method-inverse",
    "method-required-super",
    "method-search",
    "missing-readme",
    "missing-return",
    "odoo-addons-relative-import",
    "odoo-exception-warning",
    "renamed-field-parameter",
    "resource-not-exist",
    "sql-injection",
    "translation-contains-variable",
    "translation-field",
    "translation-format-interpolation",
    "translation-format-truncated",
    "translation-fstring-interpolation",
    "translation-not-lazy",
    "translation-required",
    "translation-too-few-args",
    "translation-too-many-args",
    "translation-unsupported-format",
    "use-vim-comment",
    "website-manifest-key-not-valid-uri",
{% if is_project_for_apps %}
    # Checks for modules published in the Odoo Apps store (odoo.com/apps) enabled
    # from the --is-project-for-apps option (PRECOMMIT_IS_PROJECT_FOR_APPS)
    "category-allowed-app",
    "manifest-required-key-app",
    "missing-odoo-file-app",
{% endif %}
]

ignore = [
{% if ruff_disable_checks %}
    # Disabled from RUFF_DISABLE_CHECKS option
{% for check in ruff_disable_checks %}
    "{{ check }}",
{% endfor %}
{% endif %}
{% if not is_project_for_apps %}
    # The odoo.com/apps checks only apply for modules published in the Odoo Apps store
    # so they are explicitly disabled (see --is-project-for-apps / PRECOMMIT_IS_PROJECT_FOR_APPS)
    "OAPP",  # category-allowed-app, manifest-required-key-app and missing-odoo-file-app
{% endif %}
    # Checks disabled at every level, not only here (they are listed in this ignore to keep
    # a record of the decision, the select above simply does not name them):
    #  - ambiguous-variable-name: "l" is used everywhere for "line" and the IDE fonts do
    #    distinguish "1" from "l", so the check only produces churn
    #  - invalid-envvar-default: too nitpick, only the non-str value (invalid-envvar-value,
    #    a real TypeError) is kept selected above
    #  - translation-positional-used: we always write English thinking in Spanish, a term that
    #    does not fit the other language is noticed right away and the cases actually needing
    #    the positional form are rare. It is the only one of the three with an autofix, so it is
    #    also named in the .ruff-autofix.toml ignore (that configuration selects "ALL")
    "ambiguous-variable-name",
    "invalid-envvar-default",
    "translation-positional-used",
    # Same ignores previously configured in .config/.flake8
    # line-too-long, redefined-while-unused and tab-after-comma used to be ignored here and
    # selected from the optional configuration, so they are selected above now
    "missing-whitespace-around-arithmetic-operator",  # missing whitespace around arithmetic operator (better autofixing)
    "multiple-spaces-after-comma",  # multiple spaces after ',' (better autofixing)
    "whitespace-before-punctuation",  # whitespace before ':' is handled by black and it doesn't consider black syntax
]

[lint.flake8-bandit]
# try-except-pass only reports "except Exception"/"except BaseException" by default, while the
# ruff-odoo except-pass it replaces reported any handler whose body is a bare "pass" -- and so did
# the bandit B110 it is ported from. This option restores that scope
check-typed-exception = true
# Same as the "markupsafe_xss allowed_calls" option of the old .config/.bandit-optional.yml
# Markup() is required to post HTML in Odoo (mail_thread.message_post() runs escape(body) and
# keeps it as is only for Markup objects), so the value can not simply be escaped. Wrapping the
# value with html_sanitize() is the safe way to build it, so it is whitelisted instead of
# forcing "# noqa" comments
allowed-markup-calls = [
    "odoo.tools.html_sanitize",
    "odoo.tools.mail.html_sanitize",
]

[lint.flake8-builtins]
# Same as the pylint "good-names" option: "id" is commonly redefined in Odoo
builtins-ignorelist = ["id"]

[lint.odoo]
# Version-scoped Odoo checks are gated by ruff-odoo based on this odoo-version setting
# It is also the odoo serie required in the manifest "version" key by manifest-version-format
# the same way pylint-odoo used its "valid-odoo-version" option
# (see .pylintrc). Without it any 5 numeric parts version is valid
{%- if odoo_version %}
odoo-version = "{{ odoo_version }}"
{%- endif %}
# Same values configured for the pylint-odoo checks replaced by these ruff-odoo ones:
#  - category-allowed uses the [ODOOLINT] "category-allowed" option
#  - missing-odoo-file uses the [ODOOLINT] "odoo-required-files" option
# Both are empty (the same pylint-odoo default) so both checks are inert, they are kept here
# to configure them from a single place. The odoo.com/apps counterparts (category-allowed-app
# and missing-odoo-file-app)
# have their own fixed values so they are not configurable from here
category-allowed = []
odoo-required-files = []
# Same values the [ODOOLINT] section of .config/.pylintrc-optional configured for the
# pylint-odoo checks replaced by the ruff-odoo ones promoted from the optional configuration:
#  - license-allowed uses the [ODOOLINT] "license-allowed" option
#  - manifest-required-author uses the [ODOOLINT] "manifest-required-authors" option
# manifest-deprecated-key is not configured here on purpose: the ruff-odoo default is already
# the [ODOOLINT] "manifest-deprecated-keys" value (active and description, plus qweb from 16.0
# on) and it gates qweb by the odoo-version above instead of by the configuration file
license-allowed = [
    "AGPL-3",
    "GPL-2",
    "GPL-2 or any later version",
    "GPL-3",
    "GPL-3 or any later version",
    "LGPL-3",
    "Other OSI approved licence",
    "Other proprietary",
    "OEEL-1",
    "OPL-1",
]
manifest-required-authors = [
    "Vauxoo",
    "Odoo Community Association (OCA)",
    "Jarsa",
]

[lint.mccabe]
# Same as the .pylintrc-optional [DESIGN] max-complexity option
#  Value definied from https://en.wikipedia.org/wiki/Cyclomatic_complexity
#   - The figure of 10 had received substantial corroborating evidence,
#     but that in some circumstances it may be appropriate to relax the restriction
#     and permit modules with a complexity as high as 15
max-complexity = 15

[lint.pycodestyle]
# The bugbear B950 that used to report the long lines from .config/.flake8-optional allows the
# line to run 10% past the limit before complaining, so a line is only reported past 130
# characters even though the formatter still wraps at the 119 of "line-length" above. ruff draws
# the same distinction: "line-length" is what the formatter targets, this option is where
# line-too-long starts reporting
max-line-length = 130

[lint.pylint]
# Same limits as the .pylintrc [DESIGN] section
max-args = 200
max-locals = 200
max-nested-blocks = 10
max-public-methods = 200
max-returns = 6

[lint.per-file-ignores]
"**/migrations/**" = [
    # Migration scripts run once, on a database being upgraded, from a controlled environment,
    # and no deployed code path ever imports them, so none of these are an attack surface
    # there. It notably drops assert (S101), which a migration script uses to state what the
    # database must look like before it goes on.
    "S",
    # Same reasoning, and it is the noisiest one there. A migration script builds its SQL
    # from the table and column names it is upgrading, which no request ever reaches
    "sql-injection",
]
"**/tests/**" = [
    # Same as the "exclude_dirs: tests" every .config/.bandit-*.yml used to carry, and as the
    # ignore the experimental configuration already applies: test code is never deployed, so
    # none of these are an attack surface there. Covers assert (S101), exec-builtin (S102),
    # try-except-pass (S110), suspicious-eval-usage (S307),
    # suspicious-non-cryptographic-random-usage (S311), unsafe-markup-use (S704) and anything
    # added to the family later.
    "S",
    # It is not part of the "S" prefix but it is a security check like the rest, and a test
    # builds its SQL from the data it just created rather than from a request
    "sql-injection",
]
"__init__.py" = [
    "unused-import",  # imported but unused is legal in odoo __init__.py files
]
"__manifest__.py" = [
    "useless-expression",  # the manifest is a bare dict literal, so the whole file is one
                           # expression nothing assigns
]
"docs/conf.py" = [
    "builtin-variable-shadowing",  # Sphinx requires assigning the "copyright" builtin variable name
]
