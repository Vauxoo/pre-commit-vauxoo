exclude: |
  (?x)(
    # NOT INSTALLABLE ADDONS
    # END NOT INSTALLABLE ADDONS
    # Files and folders generated by bots, to avoid loops
    ^setup/|/static/description/index\.html$|
    # We don't want to mess with tool-generated files
    .svg$|/tests/([^/]+/)?cassettes/|
    # Maybe reactivate this when all README files include prettier ignore tags?
    ^README\.md$|
    # Library files can have extraneous formatting (even minimized)
    /static/(src/)?lib/|
    # Repos using Sphinx to generate docs don't need prettying
    ^docs/_templates/.*\.html$|
    # You don't usually want a bot to modify your legal texts
    (LICENSE.*|COPYING.*)|
    (\.travis\.yml|\.gitlab\-ci\.yml|\.pre\-commit\-config*\.yaml)|
    # It was ignored from original MQT since that there is not init file
    (/migrations/1[0-4])|
    {% if exclude_lint_regex -%}
    {{ "# EXCLUDE_LINT" }}
    {{ exclude_lint_regex }}
    {%- endif %}
    (/doc/|/docs/)
  )
default_language_version:
  python: python3
  node: "26.7.0"
repos:
  - repo: https://github.com/Vauxoo/ruff-odoo-pre-commit
    rev: 0.16.3.35{# b2v-ruff #}
    hooks:
      - id: ruff-check
        name: ruff-odoo checks
        args:
          - --config=.config/.ruff.toml
  - repo: https://github.com/PyCQA/flake8
{%- if flake8_matrix_value >= 20 %}
    rev: 7.3.0
{%- else %}
    rev: 6.1.0
{%- endif %}
    hooks:
      - id: flake8
        name: flake8 + bugbear checks
{%- if flake8_matrix_value >= 20 %}
        additional_dependencies: ["flake8-bugbear==25.11.29"]
{%- else %}
        additional_dependencies: ["flake8-bugbear==23.9.16"]
{%- endif %}
        args:
          - --config=.config/.flake8
  - repo: https://github.com/OCA/pylint-odoo
{%- if pylint_matrix_value >= 20 %}
    rev: v10.0.11{# b2v-pylint #}
{%- else %}
    rev: v9.3.24
{%- endif %}
    hooks:
      - id: pylint_odoo
        name: pylint checks
        args:
          - --rcfile=.config/.pylintrc
          - --disable={{ pylint_disable_checks | join(",") if pylint_disable_checks else "R0000" }}
{%- if pylint_matrix_value >= 20 %}
          - --jobs=3
{%- endif %}
  - repo: https://github.com/OCA/odoo-pre-commit-hooks
{%- if oca_hooks_matrix_value >= 20 %}
    rev: v0.2.26
{%- else %}
    rev: v0.1.7
{%- endif %}
    hooks:
      - id: oca-checks-odoo-module
        args:
          - --config=.config/.oca_hooks.cfg
      - id: oca-checks-po
        args:
          - --config=.config/.oca_hooks.cfg
  - repo: https://github.com/PyCQA/doc8
    rev: v2.0.0
    hooks:
      - id: doc8
        name: RST lint
        args:
          - --config=.config/doc8.ini
  - repo: https://github.com/Vauxoo/eslint-odoo
    rev: e3d60e0c3174687933c35dd39e5aa11873d08896
    hooks:
      - id: eslint-odoo
        name: odoo javascript mandatory checks
  - repo: https://github.com/pre-commit/mirrors-eslint
    rev: v10.8.1
    hooks:
      - id: eslint
        name: javascript mandatory checks
        args:
          - --color
          - --config=.config/.eslintrc.config.mjs
  - repo: local
    hooks:
      - id: name-non-ascii
        name: Use only ASCII (no accents or special characters) for filenames and directory names
        description: It may raise errors on OS without locale settings configured
        entry: Use only ASCII (no accents or special characters) for filenames and directory names
        language: fail
        files: '[^\x00-\x7F]'
      - id: vx-check-deactivate
        name: deactivate.jinja and neutralize.sql syntax check.
        description: Validate deactivate.jinja and neutralize.sql files' syntax.
        entry: vx-check-deactivate
        args: []
        language: python
        types: [text]
        files: (^deactivate\.jinja$|/data/neutralize\.sql$)
      - id: vx-check-commit-log
        name: commit message range check
        description: Validate commit messages from VERSION..HEAD using the Odoo/Vauxoo structure.
        entry: vx-check-commit-log
        language: python
        pass_filenames: false
        always_run: true
  - repo: https://github.com/pre-commit/pre-commit-hooks
{%- if pre_commit_matrix_value >= 20 %}
    rev: v6.0.0
{%- else %}
    rev: v4.5.0
{%- endif %}
    hooks:
      - id: check-case-conflict
      - id: check-docstring-first
      - id: check-executables-have-shebangs
      - id: check-json
      - id: check-merge-conflict
        # exclude files where underlines are not distinguishable from merge conflicts
        exclude: /README\.rst$|^docs/.*\.rst$
      - id: check-symlinks
      - id: check-xml
