# Mandatory ruff checks
# It runs ruff-odoo (https://github.com/Vauxoo/ruff-odoo), the Vauxoo fork of ruff
# with the Odoo-specific ODOO* rules ported from pylint-odoo and odoo-pre-commit-hooks
# It replaces the flake8 and pylint mandatory checks already implemented in ruff:
#  - flake8 only keeps the continuation-line rules (E12x/E13x/E704) not implemented in ruff (see .flake8)
#  - pylint only keeps the checks without a ruff equivalent (see .pylintrc "migrated to ruff" section)
line-length = 119
preview = true  # Required by the pycodestyle rules (E1xx,E2xx,E3xx,W391) migrated from flake8
target-version = "{{ py_target_version }}"  # Mapped from the odoo version (VERSION or --odoo-version)

[lint]
select = [
    # flake8 replacement (same checks previously running from .config/.flake8)
    "E",  # pycodestyle errors (E12x continuation-line rules still running from flake8)
    "W",  # pycodestyle warnings
    "F",  # pyflakes (it also replaces the pylint checks undefined-variable, unused-import, unused-variable,
          # duplicate-key, assert-on-tuple, wildcard-import, misplaced-future, literal-comparison,
          # the %-format and str.format checks (truncated-format-string, mixed-format-string,
          # format-needs-mapping, missing-format-string-key, too-many/few-format-args, bad-format-string,
          # unused-format-string-key/argument, missing-format-argument-key, format-combined-specification),
          # duplicate-argument-name (reported as an always-on ruff syntax error),
          # notimplemented-raised, f-string-without-interpolation, not-in-loop,
          # return-outside-function, yield-outside-function, too-many-star-expressions and undefined-all-variable)
    # pylint mandatory checks with a ruff replacement (disabled now from .config/.pylintrc)
    "A001",  # redefined-builtin (variables)
    "A002",  # redefined-builtin (arguments)
    "A004",  # redefined-builtin (imports)
    "B002",  # nonexistent-operator
    "B006",  # dangerous-default-value
    "B012",  # lost-exception
    "B019",  # method-cache-max-size-none
    "B025",  # duplicate-except
    "B033",  # duplicate-value
    "C401",  # consider-using-set-comprehension for set(generator)
    "C402",  # consider-using-dict-comprehension for dict(generator)
    "C403",  # consider-using-set-comprehension for set([...])
    "C404",  # consider-using-dict-comprehension for dict([...])
    "C416",  # unnecessary-comprehension
    "C419",  # use-a-generator (with preview it also covers consider-using-generator)
    "D419",  # empty-docstring
    "G001",  # logging-format-interpolation
    "G002",  # logging-not-lazy (%)
    "G003",  # logging-not-lazy (+ concatenation)
    "G004",  # logging-fstring-interpolation
    "N804",  # bad-classmethod-argument
    "N805",  # no-self-argument
    "PIE790",  # unnecessary-pass
    "PLC0105",  # typevar-name-incorrect-variance
    "PLC0131",  # typevar-double-variance
    "PLC0132",  # typevar-name-mismatch
    "PLC0205",  # single-string-used-for-slots
    "PLC0207",  # use-maxsplit-arg
    "PLC0208",  # use-sequence-for-iteration
    "PLC0414",  # useless-import-alias
    "PLC0415",  # import-outside-toplevel
    "PLC1802",  # use-implicit-booleaness-not-len
    "PLC2401",  # non-ascii-name
    "PLC2403",  # non-ascii-module-import
    "PLC2801",  # unnecessary-dunder-call
    "PLC3002",  # unnecessary-direct-lambda-call
    "PLE0100",  # init-is-generator
    "PLE0101",  # return-in-init
    "PLE0115",  # nonlocal-and-global
    "PLE0116",  # continue-in-finally
