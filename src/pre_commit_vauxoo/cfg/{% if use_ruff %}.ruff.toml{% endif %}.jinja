# Mandatory ruff checks
# It runs ruff-odoo (https://github.com/Vauxoo/ruff-odoo), the Vauxoo fork of ruff
# with the Odoo-specific rules ported from pylint-odoo and odoo-pre-commit-hooks
# It replaces the flake8 and pylint mandatory checks already implemented in ruff:
#  - flake8 only keeps the continuation-line rules (E12x/E13x/E704) not implemented in ruff (see .flake8)
#  - pylint only keeps the checks without a ruff equivalent (see .pylintrc "migrated to ruff" section)
line-length = 119
# Required by the pycodestyle rules migrated from flake8 and to select the checks by name
# instead of by code (selecting rules by name requires preview mode)
preview = true
target-version = "{{ py_target_version }}"  # Mapped from the odoo version (VERSION or --odoo-version)

[lint]
select = [
    # flake8 replacement (same checks previously running from .config/.flake8)
    "E",  # pycodestyle errors (E12x continuation-line rules still running from flake8)
    "W",  # pycodestyle warnings
    "F",  # pyflakes (it also replaces the pylint checks undefined-variable, unused-import, unused-variable,
          # duplicate-key, assert-on-tuple, wildcard-import, misplaced-future, literal-comparison,
          # the %-format and str.format checks (truncated-format-string, mixed-format-string,
          # format-needs-mapping, missing-format-string-key, too-many/few-format-args, bad-format-string,
          # unused-format-string-key/argument, missing-format-argument-key, format-combined-specification),
          # duplicate-argument-name (reported as an always-on ruff syntax error),
          # notimplemented-raised, f-string-without-interpolation, not-in-loop,
          # return-outside-function, yield-outside-function, too-many-star-expressions and undefined-all-variable)
    # pylint mandatory checks with a ruff replacement (disabled now from .config/.pylintrc)
    "assert-on-string-literal",
    "await-outside-async",
    "bad-open-mode",
    "bad-staticmethod-argument",
    "bad-str-strip-call",
    "bad-string-format-character",  # bad-format-character
    "bad-string-format-type",
    "bidirectional-unicode",
    "binary-op-exception",
    "boolean-chained-comparison",  # chained-comparison
    "builtin-argument-shadowing",  # redefined-builtin (arguments)
    "builtin-import-shadowing",  # redefined-builtin (imports)
    "builtin-variable-shadowing",  # redefined-builtin (variables)
    "cached-instance-method",  # method-cache-max-size-none
    "comparison-of-constant",  # comparison-of-constants
    "comparison-with-itself",
    "continue-in-finally",
    "debugger",  # forgotten-debug-statement
    "dict-iter-missing-items",
    "double-negation",  # unnecessary-negation
    "duplicate-bases",
    "duplicate-isinstance-call",  # consider-merging-isinstance
    "duplicate-try-block-exception",  # duplicate-except
    "duplicate-value",
    "empty-docstring",
    "exec-builtin",  # exec-used
    "expr-and-false",  # condition-evals-to-constant (x and False)
    "expr-and-not-expr",  # condition-evals-to-constant (x and not x)
    "expr-or-not-expr",  # condition-evals-to-constant (x or not x)
    "expr-or-true",  # condition-evals-to-constant (x or True)
    "global-at-module-level",
    "global-statement",
    "global-variable-not-assigned",
    "if-else-block-instead-of-dict-get",  # consider-using-get (autofixed from .ruff-autofix.toml,
                                          # selected here to keep the mandatory level it had in pylint)
    "if-expr-with-false-true",  # simplifiable-if-expression (False if x else True)
    "if-expr-with-true-false",  # simplifiable-if-expression (True if x else False)
    "if-stmt-min-max",  # consider-using-min-builtin and consider-using-max-builtin
    "import-outside-top-level",  # import-outside-toplevel
    "in-dict-keys",  # consider-iterating-dictionary
    "invalid-all-format",
    "invalid-all-object",
    "invalid-bool-return-type",  # invalid-bool-returned
    "invalid-bytes-return-type",  # invalid-bytes-returned
    "invalid-character-backspace",
    "invalid-character-esc",
    "invalid-character-nul",
    "invalid-character-sub",
    "invalid-character-zero-width-space",
    "invalid-envvar-value",
    "invalid-first-argument-name-for-class-method",  # bad-classmethod-argument
    "invalid-first-argument-name-for-method",  # no-self-argument
    "invalid-hash-return-type",  # invalid-hash-returned
    "invalid-index-return-type",  # invalid-index-returned
    "invalid-length-return-type",  # invalid-length-returned
    "invalid-str-return-type",  # invalid-str-returned
    "iteration-over-set",  # use-sequence-for-iteration
    "jump-statement-in-finally",  # lost-exception
    "len-test",  # use-implicit-booleaness-not-len
    "load-before-global-declaration",  # used-prior-global-declaration
    "logging-f-string",  # logging-fstring-interpolation
    "logging-percent-format",  # logging-not-lazy (%)
    "logging-string-concat",  # logging-not-lazy (+ concatenation)
    "logging-string-format",  # logging-format-interpolation
    "logging-too-few-args",
    "logging-too-many-args",
    "manual-from-import",  # consider-using-from-import
    "misplaced-bare-raise",
    "missing-maxsplit-arg",  # use-maxsplit-arg
    "modified-iterating-set",
    "mutable-argument-default",  # dangerous-default-value
    "named-expr-without-context",
    "nan-comparison",
    "needless-bool",  # simplifiable-if-statement
    "nested-min-max",
    "no-classmethod-decorator",
    "no-staticmethod-decorator",
    "non-ascii-import-name",  # non-ascii-module-import
    "non-ascii-name",
    "non-slot-assignment",  # assigning-non-slot
    "nonlocal-and-global",
    "nonlocal-without-binding",
    "potential-index-error",
    "property-with-parameters",
    "redeclared-assigned-name",
    "redefined-argument-from-local",
    "redefined-slots-in-subclass",
    "repeated-equality-comparison",  # consider-using-in
    "repeated-keyword-argument",  # repeated-keyword
    "return-in-init",
    "self-assigning-variable",
    "shallow-copy-environ",
    "single-string-slots",  # single-string-used-for-slots
    "singledispatch-method",
    "singledispatchmethod-function",
    "stop-iteration-return",
    "subprocess-popen-preexec-fn",
    "subprocess-run-without-check",  # subprocess-run-check
    "super-call-with-parameters",  # super-with-arguments
    "super-without-brackets",
    "superfluous-else-break",  # no-else-break
    "superfluous-else-continue",  # no-else-continue
    "superfluous-else-raise",  # no-else-raise
    "superfluous-else-return",  # no-else-return
    "suspicious-eval-usage",  # eval-used
    "swap-with-temporary-variable",  # consider-swap-variables
    "sys-exit-alias",  # consider-using-sys-exit
    "too-many-arguments",
    "too-many-locals",
    "too-many-nested-blocks",
    "too-many-public-methods",
    "too-many-return-statements",
    "trailing-comma-on-bare-tuple",  # trailing-comma-tuple
    "type-bivariance",  # typevar-double-variance
    "type-name-incorrect-variance",  # typevar-name-incorrect-variance
    "type-param-name-mismatch",  # typevar-name-mismatch
    "unary-prefix-increment-decrement",  # nonexistent-operator
    "unexpected-special-method-signature",
    "unnecessary-comprehension",
    "unnecessary-comprehension-in-call",  # use-a-generator (with preview it also covers
                                          # consider-using-generator, which was optional in pylint,
                                          # but a single ruff rule reports both so it keeps the
                                          # mandatory level of use-a-generator)
    "unnecessary-dict-index-lookup",
    "unnecessary-direct-lambda-call",
    "unnecessary-dunder-call",
    "unnecessary-generator-dict",  # consider-using-dict-comprehension for dict(generator)
    "unnecessary-generator-set",  # consider-using-set-comprehension for set(generator)
    "unnecessary-lambda",
    "unnecessary-list-comprehension-dict",  # consider-using-dict-comprehension for dict([...])
    "unnecessary-list-comprehension-set",  # consider-using-set-comprehension for set([...])
    "unnecessary-list-index-lookup",
    "unnecessary-placeholder",  # unnecessary-pass
    "useless-else-on-loop",
    "useless-exception-statement",  # pointless-exception-statement
    "useless-expression",  # expression-not-assigned and pointless-statement, both mandatory in
                           # pylint (a single ruff rule reports the two of them). It used to run
                           # from the optional configuration while pylint kept reporting it here,
                           # so the same statement was reported twice at two different levels
    "useless-import-alias",
    "useless-object-inheritance",
    "useless-return",
    "useless-with-lock",
    "yield-from-in-async-function",  # yield-inside-async-function
    "yield-in-for-loop",  # use-yield-from
    "yield-in-init",  # init-is-generator
    # Odoo checks from ruff-odoo (ported from pylint-odoo and odoo-pre-commit-hooks)
    # Each check keeps the same level it had before the ruff migration, so only the ones
    # that were mandatory in pylint-odoo are selected here:
    #  - The ones that were optional (attribute-deprecated, sql-injection, the translation-*
    #    family, ...) run from .ruff-optional.toml
    #  - no-search-all was experimental in pylint-odoo and is promoted to mandatory here: since
    #    ruff-odoo 0.16.3.31 it only reports an unlimited search on the models that actually grow
    #    (see the no-search-all-models option), which is a real performance bug worth blocking a
    #    merge request rather than a warning nobody reads
    #  - The autofixable ones (manifest-deprecated-key, unused-logger and header-comments) run
    #    from the autofix configuration instead (see .ruff-autofix.toml).
    #    prefer-env-translation and prefer-env-attribute (deprecated-self-cr) are autofixable too
    #    but they were mandatory, so they are also selected here to keep reporting them when the
    #    autofix hook is not executed
    #  - manifest-required-author, license-allowed and manifest-deprecated-key were optional in
    #    pylint-odoo so they run from .ruff-optional.toml, where the [lint.odoo] options keep the
    #    values the [ODOOLINT] section of .pylintrc-optional configured for them
    #  - Version-dependent gating is handled by ruff-odoo's internal logic when --odoo-version
    #    is passed to ruff-odoo; all version-scoped checks are always enabled here and ruff-odoo
    #    filters them
    "category-allowed",  # Inert until the category-allowed option is set (see [lint.odoo])
    "consider-merging-classes-inherited",
    "deprecated-inselect-operator",
    "deprecated-name-get",
    "development-status-allowed",
    "inheritable-method-lambda",
    "inheritable-method-string",
    "invalid-commit",
    "invalid-email",
    "manifest-behind-migrations",
    "manifest-external-assets",
    "manifest-required-key",
    "manifest-summary-multiline",
    "missing-odoo-file",  # Inert until the odoo-required-files option is set (see [lint.odoo])
    "no-raise-unlink",
    "no-search-all",
    "no-wizard-in-models",
    "no-write-in-compute",
    "prefer-env-attribute",  # deprecated-self-cr, autofixed from .ruff-autofix.toml, reported
                             # here as mandatory the same way prefer-env-translation is
    "prefer-env-translation",  # Autofixed from .ruff-autofix.toml, reported here as mandatory
    "prohibited-method-override",
    "super-method-mismatch",
    "test-folder-imported",
    "translation-injection",
{% if is_project_for_apps %}
    # Checks for modules published in the Odoo Apps store (odoo.com/apps) enabled
    # from the --is-project-for-apps option (PRECOMMIT_IS_PROJECT_FOR_APPS)
    "category-allowed-app",
    "manifest-required-key-app",
    "missing-odoo-file-app",
{% endif %}
]

ignore = [
{% if ruff_disable_checks %}
    # Disabled from RUFF_DISABLE_CHECKS option
{% for check in ruff_disable_checks %}
    "{{ check }}",
{% endfor %}
{% endif %}
{% if not is_project_for_apps %}
    # The odoo.com/apps checks only apply for modules published in the Odoo Apps store
    # so they are explicitly disabled (see --is-project-for-apps / PRECOMMIT_IS_PROJECT_FOR_APPS)
    "OAPP",  # category-allowed-app, manifest-required-key-app and missing-odoo-file-app
{% endif %}
    # Checks disabled at every level, not only here (they are listed in this ignore to keep
    # a record of the decision, the select above simply does not name them):
    #  - ambiguous-variable-name: "l" is used everywhere for "line" and the IDE fonts do
    #    distinguish "1" from "l", so the check only produces churn
    #  - invalid-envvar-default: too nitpick, only the non-str value (invalid-envvar-value,
    #    a real TypeError) is kept selected above
    #  - translation-positional-used: we always write English thinking in Spanish, a term that
    #    does not fit the other language is noticed right away and the cases actually needing
    #    the positional form are rare
    "ambiguous-variable-name",
    "invalid-envvar-default",
    "translation-positional-used",
    # Same ignores previously configured in .config/.flake8
    "line-too-long",  # line-too-long (reported by the optional configuration, which reproduces
                      # the bugbear B950 tolerance, and reformatted by the autofix)
    "missing-whitespace-around-arithmetic-operator",  # missing whitespace around arithmetic operator (better autofixing)
    "multiple-spaces-after-comma",  # multiple spaces after ',' (better autofixing)
    "redefined-while-unused",  # redefinition is legal in odoo 8 when we implement 2 interfaces for a method
    "tab-after-comma",  # tab after ',' (enabled from the optional configuration)
    "whitespace-before-punctuation",  # whitespace before ':' is handled by black and it doesn't consider black syntax
]

[lint.flake8-builtins]
# Same as the pylint "good-names" option: "id" is commonly redefined in Odoo
builtins-ignorelist = ["id"]

[lint.odoo]
# Version-scoped Odoo checks are gated by ruff-odoo based on this odoo-version setting
# It is also the odoo serie required in the manifest "version" key by manifest-version-format
# the same way pylint-odoo used its "valid-odoo-version" option
# (see .pylintrc). Without it any 5 numeric parts version is valid
{%- if odoo_version %}
odoo-version = "{{ odoo_version }}"
{%- endif %}
# Same values configured for the pylint-odoo checks replaced by these ruff-odoo ones:
#  - category-allowed uses the [ODOOLINT] "category-allowed" option
#  - missing-odoo-file uses the [ODOOLINT] "odoo-required-files" option
# Both are empty (the same pylint-odoo default) so both checks are inert, they are kept here
# to configure them from a single place. The odoo.com/apps counterparts (category-allowed-app
# and missing-odoo-file-app)
# have their own fixed values so they are not configurable from here
category-allowed = []
odoo-required-files = []

[lint.pylint]
# Same limits as the .pylintrc [DESIGN] section
max-args = 200
max-locals = 200
max-nested-blocks = 10
max-public-methods = 200
max-returns = 6

[lint.per-file-ignores]
"__init__.py" = [
    "unused-import",  # imported but unused is legal in odoo __init__.py files
]
"__manifest__.py" = [
    "useless-expression",  # the manifest is a bare dict literal, so the whole file is one
                           # expression nothing assigns (same ignore the optional configuration
                           # had while this check ran from there)
]
"docs/conf.py" = [
    "builtin-variable-shadowing",  # Sphinx requires assigning the "copyright" builtin variable name
]
