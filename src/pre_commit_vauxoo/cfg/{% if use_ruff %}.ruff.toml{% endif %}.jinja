    "PLR1733",  # unnecessary-dict-index-lookup
    "PLR1736",  # unnecessary-list-index-lookup
    "PLW0108",  # unnecessary-lambda
    "PLW0120",  # useless-else-on-loop
    "PLW0127",  # self-assigning-variable
    "PLW0128",  # redeclared-assigned-name
    "PLW0129",  # assert-on-string-literal
    "PLW0131",  # named-expr-without-context
    "PLW0133",  # pointless-exception-statement
    "PLW0177",  # nan-comparison
    "PLW0211",  # bad-staticmethod-argument
    "PLW0245",  # super-without-brackets
    "PLW0602",  # global-variable-not-assigned
    "PLW0603",  # global-statement
    "PLW0604",  # global-at-module-level
    "PLW0711",  # binary-op-exception
    "PLW1501",  # bad-open-mode
    "PLW1507",  # shallow-copy-environ
    "PLW1508",  # invalid-envvar-default
    "PLW1509",  # subprocess-popen-preexec-fn
    "PLW1510",  # subprocess-run-check
    "PLW2101",  # useless-with-lock
    "PLW3301",  # nested-min-max
    "RET505",  # no-else-return
    "RET506",  # no-else-raise
    "RET507",  # no-else-continue
    "RET508",  # no-else-break
    "S102",  # exec-used
    "S307",  # eval-used
    "SIM101",  # consider-merging-isinstance
    "SIM103",  # simplifiable-if-statement
    "SIM118",  # consider-iterating-dictionary
    "SIM208",  # unnecessary-negation
    "SIM210",  # simplifiable-if-expression (True if x else False)
    "SIM211",  # simplifiable-if-expression (False if x else True)
    "SIM220",  # condition-evals-to-constant (x and not x)
    "SIM221",  # condition-evals-to-constant (x or not x)
    "SIM222",  # condition-evals-to-constant (x or True)
    "SIM223",  # condition-evals-to-constant (x and False)
    "T100",  # forgotten-debug-statement
    "UP004",  # useless-object-inheritance
    "UP008",  # super-with-arguments
]

ignore = [
{% if ruff_disable_checks %}
    # Disabled from RUFF_DISABLE_CHECKS option
{% for check in ruff_disable_checks %}
    "{{ check }}",
{% endfor %}
{% endif %}
    # Same ignores previously configured in .config/.flake8
    "E203",  # whitespace before ':' is handled by black and it doesn't consider black syntax
    "E226",  # missing whitespace around arithmetic operator (better autofixing)
    "E241",  # multiple spaces after ',' (better autofixing)
    "E242",  # tab after ',' (enabled from the optional configuration)
    "E501",  # line-too-long (handled by the autofix and bugbear B950 from optional)
    "E741",  # do not use variables named 'l', 'O', or 'I' (enabled from the optional configuration)
    "F811",  # redefinition is legal in odoo 8 when we implement 2 interfaces for a method
]

[lint.flake8-builtins]
# Same as the pylint "good-names" option: "id" is commonly redefined in Odoo
builtins-ignorelist = ["id"]

[lint.pylint]
# Same limits as the .pylintrc [DESIGN] section
max-args = 200
max-locals = 200
max-nested-blocks = 5
max-public-methods = 200
max-returns = 6

[lint.per-file-ignores]
"__init__.py" = [
    "F401",  # imported but unused is legal in odoo __init__.py files
]
"docs/conf.py" = [
    "A001",  # Sphinx requires assigning the "copyright" builtin variable name
]
