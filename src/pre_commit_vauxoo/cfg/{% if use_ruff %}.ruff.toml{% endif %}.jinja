{% if is_project_for_apps %}
    # Checks for modules published in the Odoo Apps store (odoo.com/apps) enabled
    # from the --is-project-for-apps option (PRECOMMIT_IS_PROJECT_FOR_APPS)
    "ODOOAPP001",  # category-allowed-app
    "ODOOAPP002",  # missing-odoo-file-app
    "ODOOAPP003",  # manifest-required-key-app
{% endif %}
]

ignore = [
{% if ruff_disable_checks %}
    # Disabled from RUFF_DISABLE_CHECKS option
{% for check in ruff_disable_checks %}
    "{{ check }}",
{% endfor %}
{% endif %}
{% if not is_project_for_apps %}
    # The ODOOAPP checks only apply for modules published in the Odoo Apps store
    # so they are explicitly disabled since selecting the whole ODOO group would
    # enable them too (see --is-project-for-apps / PRECOMMIT_IS_PROJECT_FOR_APPS)
    "ODOOAPP",  # category-allowed-app, missing-odoo-file-app and manifest-required-key-app
{% endif %}
    # Same ignores previously configured in .config/.flake8
    "E203",  # whitespace before ':' is handled by black and it doesn't consider black syntax
    "E226",  # missing whitespace around arithmetic operator (better autofixing)
    "E241",  # multiple spaces after ',' (better autofixing)
    "E242",  # tab after ',' (enabled from the optional configuration)
    "E501",  # line-too-long (handled by the autofix and bugbear B950 from optional)
    "E741",  # do not use variables named 'l', 'O', or 'I' (enabled from the optional configuration)
    "F811",  # redefinition is legal in odoo 8 when we implement 2 interfaces for a method
]

[lint.flake8-builtins]
# Same as the pylint "good-names" option: "id" is commonly redefined in Odoo
builtins-ignorelist = ["id"]

[lint.odoo]
# Version-scoped ODOO checks are gated by ruff-odoo based on this odoo-version setting
{%- if odoo_version %}
odoo-version = "{{ odoo_version }}"
{%- endif %}

[lint.pylint]
# Same limits as the .pylintrc [DESIGN] section
max-args = 200
max-locals = 200
max-nested-blocks = 10
max-public-methods = 200
max-returns = 6

[lint.per-file-ignores]
"__init__.py" = [
    "F401",  # imported but unused is legal in odoo __init__.py files
]
"docs/conf.py" = [
    "A001",  # Sphinx requires assigning the "copyright" builtin variable name
]
