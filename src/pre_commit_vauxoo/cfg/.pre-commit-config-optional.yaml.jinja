exclude: |
  (?x)(
    # NOT INSTALLABLE ADDONS
    # END NOT INSTALLABLE ADDONS
    # Files and folders generated by bots, to avoid loops
    ^setup/|/static/description/index\.html$|
    # We don't want to mess with tool-generated files
    .svg$|/tests/([^/]+/)?cassettes/|
    # Maybe reactivate this when all README files include prettier ignore tags?
    ^README\.md$|
    # Library files can have extraneous formatting (even minimized)
    /static/(src/)?lib/|
    # Repos using Sphinx to generate docs don't need prettying
    ^docs/_templates/.*\.html$|
    # You don't usually want a bot to modify your legal texts
    (LICENSE.*|COPYING.*)|
    (\.travis\.yml|\.gitlab\-ci\.yml|\.pre\-commit\-config*\.yaml)|
    # It was ignored from original MQT since that there is not init file
    (/migrations/1[0-4])|
    {% if exclude_lint_regex -%}
    {{ "# EXCLUDE_LINT" }}
    {{ exclude_lint_regex }}
    {%- endif %}
    (/doc/|/docs/)
  )
default_language_version:
  python: python3
{%- if use_ruff %}
  node: "26.7.0"
{%- else %}
  node: "24.13.0"
{%- endif %}
repos:
  - repo: https://github.com/OCA/pylint-odoo
{%- if pylint_matrix_value >= 20 %}
    rev: v10.0.10{# b2v-pylint #}
{%- else %}
    rev: v9.3.24
{%- endif %}
    hooks:
      - id: pylint_odoo
        name: pylint optional checks
        args:
          - --rcfile=.config/.pylintrc-optional
          - --disable={{ pylint_disable_checks | join(",") if pylint_disable_checks else "R0000" }}
{%- if pylint_matrix_value >= 20 %}
          - --jobs=3
{%- endif %}
  - repo: https://github.com/OCA/odoo-pre-commit-hooks
{%- if oca_hooks_matrix_value >= 20 %}
    rev: v0.2.26
{%- else %}
    rev: v0.1.7
{%- endif %}
    hooks:
      - id: oca-checks-odoo-module
        args:
          - --config=.config/.oca_hooks.cfg
      - id: oca-checks-po
        args:
          - --config=.config/.oca_hooks.cfg
  - repo: https://github.com/PyCQA/doc8
    rev: v2.0.0
    hooks:
      - id: doc8
        name: RST lint
        args:
          - --config=.config/doc8.ini
  - repo: local
    hooks:
      - id: vx-check-commit-log
        name: commit message range check
        description: Validate commit messages from VERSION..HEAD using the Odoo/Vauxoo structure.
        entry: vx-check-commit-log
        language: python
        pass_filenames: false
        always_run: true
{%- if use_ruff %}
  - repo: https://github.com/Vauxoo/ruff-odoo-pre-commit
    rev: 0.16.3.27{# b2v-ruff #}
    hooks:
      - id: ruff-check
        name: ruff-odoo optional checks
        args:
          - --config=.config/.ruff-optional.toml
{%- endif %}
  - repo: https://github.com/PyCQA/flake8
{%- if flake8_matrix_value >= 20 %}
    rev: 7.3.0
{%- else %}
    rev: 6.1.0
{%- endif %}
    hooks:
      - id: flake8
        name: flake8 + bugbear optional checks
{%- if flake8_matrix_value >= 20 %}
        additional_dependencies: ["flake8-bugbear==25.11.29"]
{%- else %}
        additional_dependencies: ["flake8-bugbear==23.9.16"]
{%- endif %}
        args:
          - --config=.config/.flake8-optional
{%- if not use_ruff %}
  # B704 (markupsafe_markup_xss) is the only check enabled here and it is migrated to the ruff
  # unsafe-markup-use (S704) selected from .config/.ruff-optional.toml, which reproduces both
  # the "markupsafe_xss allowed_calls" and the "exclude_dirs: tests" options of that file
  - repo: https://github.com/PyCQA/bandit
    rev: 1.9.4
    hooks:
      - id: bandit
        name: bandit optional
        verbose: True
        args:
          # The YAML format is used instead of the INI one since it is the only
          # one supporting per-plugin options, e.g. "markupsafe_xss"
          - --configfile=.config/.bandit-optional.yml
          - --format=custom
          - "--msg-template={relpath}:{line}:{col} {msg} - [{test_id}] - ({severity})"
          - --quiet
        # reduce the INFO logger
        require_serial: true
{%- endif %}
{%- if not use_ruff %}
  # Every check enabled here has a ruff S rule, so this hook is replaced by the ruff-odoo
  # EXPERIMENTAL one below (see .config/.ruff-experimental.toml)
  - repo: https://github.com/PyCQA/bandit
    rev: 1.9.4
    hooks:
      - id: bandit
        name: bandit EXPERIMENTAL (Won't affect CI status)!
        verbose: True
        args:
          - --exit-zero
          - --configfile=.config/.bandit-experimental.yml
          - --format=custom
          - "--msg-template={relpath}:{line}:{col} {msg} - [{test_id}] - ({severity})"
          - --quiet
        # reduce the INFO logger
        require_serial: true
{%- endif %}
{%- if use_ruff %}
  - repo: https://github.com/Vauxoo/ruff-odoo-pre-commit
    rev: 0.16.3.27{# b2v-ruff #}
    hooks:
      - id: ruff-check
        name: ruff-odoo EXPERIMENTAL checks (Won't affect CI status)!
        verbose: True  # exit-zero needs verbose
        args:
          - --config=.config/.ruff-experimental.toml
          - --exit-zero
{%- endif %}
{%- if not use_ruff %}
  # Both experimental checks are migrated to ruff so this hook is replaced by the
  # ruff-odoo EXPERIMENTAL one above (see .config/.ruff-experimental.toml)
  - repo: https://github.com/OCA/pylint-odoo
{%- if pylint_matrix_value >= 20 %}
    rev: v10.0.10{# b2v-pylint #}
{%- else %}
    rev: v9.3.24
{%- endif %}
    hooks:
      - id: pylint_odoo
        name: pylint EXPERIMENTAL checks (Won't affect CI status)!
        verbose: True  # exit-zero needs verbose
        args:
          - --rcfile=.config/.pylintrc-experimental
          - --exit-zero
{%- if pylint_matrix_value >= 20 %}
          - --jobs=3
{%- endif %}
{%- endif %}
