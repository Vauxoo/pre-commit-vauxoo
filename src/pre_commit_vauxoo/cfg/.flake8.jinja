[flake8]
{% if use_ruff -%}
# The pyflakes (F) and most of the pycodestyle (E,W) checks were migrated to ruff (.config/.ruff.toml)
# Only the continuation-line indentation rules (E12x/E13x) and E704 keep running here
# since ruff does not implement them https://github.com/astral-sh/ruff/issues/2402
select = E12,E13,E704
# E123,E133 keep being ignored (same as before the ruff migration)
ignore = E123,E133
{%- else -%}
# B024: Odoo is not common to use ABC Classes not big deal to ignore it.
# B036: Don't except `BaseException` unless you plan to re-raise it. (covered by pylint)
# E123,E133,E226,E241,E242 are ignored by default by pep8 and flake8
# F811 is legal in odoo 8 when we implement 2 interfaces for a method
# F999 pylint support this case with expected tests
# W503 changed by W504 and OCA prefers allow both
# F401 is legal in odoo __init__.py files
# E203 (whitespace before ':') is handled by black and it doesn't consider black syntax like:
# E741 do not use variables named ‘l’, ‘O’, or ‘I’
# chunk = records[index : index + chunk_size]
ignore = B024,B036,E123,E133,E203,E226,E241,E242,E501,E741,F811,F601,W503,W504
per-file-ignores=
    __init__.py:F401
{%- endif %}
max-line-length = 119
# flake8 spells its parallel mode "auto", not 0 like pylint does: a numeric 0 is taken
# literally as "0 jobs", which makes flake8 fall back to run_serial() and check every file
# in a single process. Its pre-commit hook declares require_serial: true precisely because
# flake8 is expected to parallelize on its own, so there was nothing else parallelizing it
jobs = auto
