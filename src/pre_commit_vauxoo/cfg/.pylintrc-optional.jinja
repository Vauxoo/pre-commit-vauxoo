[MAIN]
ignore=CVS,.git,scenarios,.bzr
persistent=yes
load-plugins=pylint.extensions.docstyle, pylint.extensions.mccabe, pylint_odoo
{% if odoo_version -%}
valid-odoo-version={{ odoo_version }}
{%- endif %}
{% if py_version -%}
py-version={{ py_version }}
{%- endif %}

[ODOOLINT]
{% if pylint_matrix_value < 20 -%}
# Options removed from pylint-odoo >= 11.0 (the checks were migrated to ruff-odoo
# ODOO010, ODOO008 and ODOO002)
license-allowed=AGPL-3,GPL-2,GPL-2 or any later version,
    GPL-3,GPL-3 or any later version,LGPL-3,
    Other OSI approved licence,Other proprietary,
    OEEL-1, OPL-1,
manifest-required-authors=Vauxoo,
  Odoo Community Association (OCA),
  Jarsa,
manifest-deprecated-keys=active,
  description,
  {% if odoo_version and odoo_version|float >= 16.0 -%}
  qweb,
  {%- endif %}
{%- endif %}
# External scripts odoo_lint replace

[MESSAGES CONTROL]
disable=all,unknown-option-value
enable=attribute-string-redundant,
  consider-merging-classes-inherited,
  deprecated-method,
  deprecated-pragma,
  license-allowed,
  manifest-deprecated-key,
  manifest-required-author,
  manifest-version-format,
  translation-not-lazy,
  translation-format-interpolation,
  translation-format-truncated,
  translation-fstring-interpolation,
  translation-too-few-args,
  translation-too-many-args,
  translation-unsupported-format,
  use-implicit-booleaness-not-comparison-to-zero,
  use-symbolic-message-instead,
  use-vim-comment,
  useless-parent-delegation
  {%- if not use_ruff %},
  # The following checks are migrated to ruff when it is enabled
  # The ODOO* checks (from ruff-odoo), eval-used and except-pass run from the mandatory
  # .config/.ruff.toml and the rest from .config/.ruff-optional.toml
  attribute-deprecated,  # ruff ODOO021
  bad-builtin-groupby,  # ruff ODOO019
  bad-docstring-quotes,  # ruff D300
  consider-using-generator,  # ruff C419 with preview (mandatory .ruff.toml)
  context-overridden,  # ruff ODOO018
  deprecated-odoo-model-method,  # ruff ODOO037 (and ODOO034 for name_get)
  docstring-first-line-empty,  # ruff D212
  eval-used,  # ruff S307
  except-pass,  # ruff ODOO004
  external-request-timeout,  # ruff ODOO051
  implicit-str-concat,  # ruff ISC001
  invalid-commit,  # ruff ODOO017
  manifest-author-string,  # ruff ODOO009
  manifest-data-duplicated,  # ruff ODOO048
  manifest-maintainers-list,  # ruff ODOO011
  manifest-required-key,  # ruff ODOO001
  method-compute,  # ruff ODOO027
  method-inverse,  # ruff ODOO029
  method-required-super,  # ruff ODOO005
  method-search,  # ruff ODOO028
  missing-readme,  # ruff ODOO016
  missing-return,  # ruff ODOO022
  odoo-addons-relative-import,  # ruff ODOO023
  odoo-exception-warning,  # ruff ODOO020
  print-used,  # ruff T201
  redundant-u-string-prefix,  # ruff UP025
  renamed-field-parameter,  # ruff ODOO030
  resource-not-exist,  # ruff ODOO053
  sql-injection,  # ruff ODOO052
  too-complex,  # ruff C901
  translation-contains-variable,  # ruff ODOO041
  translation-field,  # ruff ODOO031
  translation-required,  # ruff ODOO049
  use-dict-literal,  # ruff C408
  use-implicit-booleaness-not-comparison-to-string,  # ruff PLC1901
  website-manifest-key-not-valid-uri  # ruff ODOO014
  {%- endif %}

[REPORTS]
msg-template={path}:{line}:{column}: ({symbol}) {msg}
output-format=colorized
reports=no
evaluation=10.0 - ((float(5 * error + warning + refactor + convention) / statement) * 10)
score=no

[FORMAT]
indent-string='    '
expected-line-ending-format=LF

[BASIC]
class-rgx=[A-Z_][a-zA-Z0-9]{2,59}
module-rgx=.*
const-rgx=.*
function-rgx=.*
method-rgx=.*
attr-rgx=.*
argument-rgx=.*
variable-rgx=.*
inlinevar-rgx=.*

[SIMILARITIES]
ignore-comments=yes
ignore-docstrings=yes

[MISCELLANEOUS]
notes=FIXME,TODO


[DESIGN]
# McCabe complexity cyclomatic threshold for too-complex check
#  Value definied from https://en.wikipedia.org/wiki/Cyclomatic_complexity
#   - The figure of 10 had received substantial corroborating evidence,
#     but that in some circumstances it may be appropriate to relax the restriction
#     and permit modules with a complexity as high as 15
max-complexity=15
