[lint.odoo]
# Version-scoped ODOO checks are gated by ruff-odoo based on this odoo-version setting
{%- if odoo_version %}
odoo-version = "{{ odoo_version }}"
{%- endif %}

[lint.isort]
combine-as-imports = true
default-section = "third-party"
section-order = [
    "future",
    "standard-library",
    "third-party",
    "odoo",
    "odoo-addons",
    "first-party",
    "local-folder",
]
split-on-trailing-comma = false

[lint.isort.sections]
odoo = ["odoo"]
odoo-addons = ["odoo.addons"]

[lint.per-file-ignores]
"__init__.py" = [
    "unsorted-imports",
    "unused-import",
]
