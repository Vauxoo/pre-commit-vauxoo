line-length = 119
preview = true
target-version = "{{ py_target_version }}"  # Mapped from the odoo version (VERSION or --odoo-version)
fix-only = true
unsafe-fixes = true

[format]
quote-style = "double"
skip-magic-trailing-comma = false
indent-style = "space"
line-ending = "lf"

[lint]
# "ALL" also selects the autofixable Odoo checks from ruff-odoo:
#   ODOO002 (manifest-deprecated-key), ODOO003 (use-vim-comment), ODOO006 (unused-logger),
#   ODOO007 (attribute-string-redundant), ODOO024 (prefer-env-translation),
#   ODOO025 (manifest-superfluous-key), ODOO026 (header-comments), ODOO035 (deprecated-self-cr),
#   ODOO048 (manifest-data-duplicated) and ODOO059 (translation-not-lazy)
# The non-autofixable ODOO checks run as mandatory instead (see .ruff.toml)
# Version-dependent gating (ODOO024 only applies for odoo >= 18.0, ODOO035 for odoo >= 19.0
# and ODOO059 for odoo >= 14.0) is handled by ruff-odoo's internal logic when --odoo-version
# is passed to ruff; all version-scoped checks are always enabled here and ruff filters them
select = ["ALL"]

ignore = [
{% if ruff_disable_checks %}
    # Disabled from RUFF_DISABLE_CHECKS option
{% for check in ruff_disable_checks %}
    "{{ check }}",
{% endfor %}
{% endif %}
{% if not is_project_for_apps %}
    # The OAPP checks only apply for modules published in the Odoo Apps store
    # so they are explicitly disabled (see --is-project-for-apps / PRECOMMIT_IS_PROJECT_FOR_APPS)
    "OAPP",  # category-allowed-app, missing-odoo-file-app and manifest-required-key-app
{% endif %}
    # Disabled
    "AIR",  # Odoo is not using 'Airflow' library yet
    "any-eq-ne-annotation",  # We are not using typing entirely yet
    "argument-default-in-stub",  # We are not using typing entirely yet
    "assignment-default-in-stub",  # We are not using typing entirely yet
    "ASYNC",  # Odoo is not using 'trio' library yet
    "bad-exit-annotation",  # We are not using typing entirely yet
    "blank-line-after-function",  # Big diff for only blank-line
    "blank-lines-between-header-and-content",  # Big diff for only docstring
    "collection-literal-concatenation",  # No regular way using list([], *[])
    "D",  # (pydocstyle) Big diff for only docstring styles
    "deprecated-import",  # We are not using typing entirely yet
    "deprecated-mock-import",  # try-except import is a valid multi-compatibility import
    "dot-format-in-exception",  # Only add an extra variable for the same string
    "duplicate-class-field-definition",  # It is unsafe removing a field definition it could need a migration script and decide by the developer the correct one
    "error-instead-of-exception",  # Sometimes we need only to log the error instead of raise it
    "escape-sequence-in-docstring",  # Big diff for only docstring
    "f-string-in-exception",  # Only add an extra variable for the same string
    "FAST", # Odoo is not using 'fastapi' library yet
    "first-word-uncapitalized",  # Big diff for only docstring
    "future-annotations-in-stub",  # We are not using typing entirely yet
    "future-required-type-annotation",  # We are not using typing entirely yet
    "future-rewritable-type-annotation",  # We are not using typing entirely yet
    "if-else-block-instead-of-if-exp",  # human readable if-else in multiple lines
    "if-exp-instead-of-or-operator",  # lints prefer if-else instead of "or", or not?
    "implicit-return-value",  # We prefer "return" than "return None"
    "implicit-return",  # We have too many methods without return
    "implicit-string-concatenation-in-collection-literal",  # Add parentheses (str\nstr) could be not needed
    "incorrectly-parenthesized-tuple-in-subscript",  # Could be buggy
    "invalid-rule-code",  # We could even use noqa with other tools
    "lambda-assignment",  # We use a lot lambda in Odoo
    "lazy-import-mismatch",  # We prefer to load the imports in order to check any error early
